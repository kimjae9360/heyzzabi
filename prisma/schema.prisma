// Hey Zzabi - Prisma schema
// Base model ported from per2, extended to match the authoritative
// 사원/회의록/기획서/프로젝트/업무배분/추적 table spec (see
// docs/superpowers/specs/2026-08-13-heyzzabi-realbackend-design.md).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  user_id         String    @id @default(uuid()) // 사번/아이디
  password        String // bcrypt hash
  name            String
  email           String    @unique // 회사 이메일
  phone           String?
  department      String // 부서 (department_id)
  position        String // 직급 (position_id) - 사원/대리/과장/부장 등
  job_title       String? // 직무 - Frontend/Backend/Designer/PM 등 (Hey Zzabi 확장 필드, 공식 스펙 외)
  role            String    @default("USER") // 시스템 권한 (role) - USER/PM/ADMIN = 직원/팀장/관리자
  employee_no     String    @unique // 사원번호
  hire_date       DateTime?
  status          String    @default("ACTIVE") // ACTIVE, LEAVE, RESIGNED, LOCKED
  profile_image   String?
  last_login_at   DateTime?
  current_workload Int      @default(0) // 업무 배분 시 워크로드 계산용 (0-100)
  stack           String? // 기술 스택 (JSON-encoded string array)
  certifications  String? // 자격증 (JSON-encoded string array)
  past_projects   String? // 주요 프로젝트 이력 (JSON-encoded string array)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  tasks               Task[]
  assignment_logs      TaskAssignmentLog[]
  notifications        Notification[]
  organized_meetings   Meeting[]            @relation("MeetingOrganizer")
  created_meetings     Meeting[]            @relation("MeetingCreator")
  participations       MeetingParticipant[]
  authored_plans       Planning[]           @relation("PlanAuthor")
  approved_plans       Planning[]           @relation("PlanApprover")
  created_projects     Project[]            @relation("ProjectAuthor")
  connected_integrations IntegrationConnection[]
  research_reports     ResearchReport[]
  chat_messages        ChatMessage[]
}

model Project {
  project_id   String    @id @default(uuid())
  title        String
  description  String?
  status       String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, SUSPENDED, HOLD
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  start_date   DateTime?
  end_date     DateTime?
  progress     Int       @default(0)
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  // Relations
  author_id String
  author    User       @relation("ProjectAuthor", fields: [author_id], references: [user_id])
  tasks     Task[]
  meetings  Meeting[]
  plannings Planning[]
  research_reports ResearchReport[]
}

model Meeting {
  meeting_id   String    @id @default(uuid())
  title        String
  meeting_date DateTime
  location     String?
  meeting_type String // 정기회의/프로젝트/부서회의 등
  content      String
  summary      String? // AI가 생성한 요약
  status       String    @default("DRAFT") // DRAFT(작성중), REVIEW(검토중), CONFIRMED(확정)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  // Relations
  project_id   String?
  project      Project?             @relation(fields: [project_id], references: [project_id])
  organizer_id String
  organizer    User                 @relation("MeetingOrganizer", fields: [organizer_id], references: [user_id])
  created_by   String
  creator      User                 @relation("MeetingCreator", fields: [created_by], references: [user_id])
  participants MeetingParticipant[]
  plannings    Planning[]
  tasks        Task[]
}

model MeetingParticipant {
  participant_id    String @id @default(uuid())
  attendance_status String @default("ATTENDED") // ATTENDED, ABSENT, PROXY
  role              String @default("PARTICIPANT") // ORGANIZER, PARTICIPANT, PRESENTER

  // Relations
  meeting_id String
  meeting    Meeting @relation(fields: [meeting_id], references: [meeting_id], onDelete: Cascade)
  user_id    String
  user       User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Planning {
  planning_id     String    @id @default(uuid()) // 기획서 ID
  title           String
  description     String?
  content         String // 기획서 본문 (LONGTEXT 대응)
  version         String    @default("1.0")
  status          String    @default("DRAFT") // DRAFT/REVIEW/APPROVED/REJECTED/COMPLETED
  rejected_reason String?
  analysis_json   String? // AI 구조화 분석 {agenda, decisions, actionItems} (JSON)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  approved_by     String?
  approved_at     DateTime?

  // Relations
  project_id String
  project    Project @relation(fields: [project_id], references: [project_id])
  meeting_id String?
  meeting    Meeting? @relation(fields: [meeting_id], references: [meeting_id])
  author_id  String
  author     User    @relation("PlanAuthor", fields: [author_id], references: [user_id])
  approver   User?   @relation("PlanApprover", fields: [approved_by], references: [user_id])
  tasks      Task[]
}

model Task {
  task_id         String    @id @default(uuid())
  title           String
  description     String?
  // PENDING_DISTRIBUTION(배분대기) / TODO / IN_PROGRESS / REVIEW / DELAYED(지연) / DONE / CANCELLED
  status          String    @default("PENDING_DISTRIBUTION")
  progress        Int       @default(0) // 0-100
  estimated_hours Int?
  difficulty      String? // High / Medium / Low
  rejected_reason String? // 배분 반려 사유
  delay_reason    String? // 지연 사유
  start_date      DateTime?
  end_date        DateTime?
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  assignee_id String?
  assignee    User?     @relation(fields: [assignee_id], references: [user_id])
  project_id  String?
  project     Project?  @relation(fields: [project_id], references: [project_id])
  planning_id String?
  planning    Planning? @relation(fields: [planning_id], references: [planning_id])
  meeting_id  String?
  meeting     Meeting?  @relation(fields: [meeting_id], references: [meeting_id])
  assignment_logs TaskAssignmentLog[]
}

// "추적" - 업무 담당자 변경 이력 (감사 추적용)
model TaskAssignmentLog {
  log_id     String   @id @default(uuid())
  action     String // ASSIGNED / REASSIGNED / REJECTED
  note       String?
  created_at DateTime @default(now())

  task_id String
  task    Task   @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])
}

model Notification {
  notification_id String   @id @default(uuid())
  message         String
  type            String   @default("info") // info/success/warning/error
  link            String?
  read            Boolean  @default(false)
  created_at      DateTime @default(now())

  user_id String?
  user    User?   @relation(fields: [user_id], references: [user_id])
}

// 지식망(Knowledge Base) - 회의록/기획서를 임베딩하여 시맨틱 검색/챗에 사용
model KnowledgeChunk {
  chunk_id    String   @id @default(uuid())
  source_type String // MEETING / PLANNING
  source_id   String // meeting_id 또는 planning_id
  title       String
  content     String
  embedding   String // JSON-encoded float array (text-embedding-3-small, 1536dim)
  category    String? // llm_wiki_graphify 스타일 대분류 자동 태깅 (예: "인증/보안", "AI 파이프라인")
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  @@unique([source_type, source_id])
}

// 챗봇(구 지식망 채팅) 히스토리 - 사용자별로 이전 대화가 남아 있어야 하므로 DB에 영속화한다
model ChatMessage {
  message_id   String   @id @default(uuid())
  role         String // user / assistant
  content      String
  sources_json String? // assistant 답변의 근거 문서 목록 (JSON, KnowledgeChunk 검색 결과)
  created_at   DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

// 외부 툴 연동 (OAuth) - provider 당 팀 전체에 하나의 연결만 유지한다
model IntegrationConnection {
  connection_id   String   @id @default(uuid())
  provider        String   @unique // github / slack / jira / gcal
  external_login  String // 연동된 외부 계정 표시명
  access_token    String // OAuth access token (평문 저장 - 로컬 개발용, 운영 전환 시 암호화 필요)
  connected_by    String
  connected_user  User     @relation(fields: [connected_by], references: [user_id])
  connected_at    DateTime @default(now())
}

// AI 딥리서치 - 9_deep_research 스킬의 "Local Packet(내부 데이터 취합) -> 다단계 질의 -> 보고서" 패턴을
// NotebookLM 없이 우리 DB(회의록/기획서/업무)와 OpenAI로 재현한다.
model ResearchReport {
  report_id     String    @id @default(uuid())
  question      String
  content       String // 마크다운 보고서 본문
  sources_json  String // 참고한 회의록/기획서/업무 id 목록 (JSON)
  degraded      Boolean   @default(false) // 내부 데이터가 부족해 제한된 근거로 작성된 경우 true
  project_id    String?
  project       Project?  @relation(fields: [project_id], references: [project_id])
  created_by    String
  created_user  User      @relation(fields: [created_by], references: [user_id])
  created_at    DateTime  @default(now())
}
